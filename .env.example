GIN_MODE=debug


DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=ecommerce_shop
DB_SSLMODE=disable



JWT_SECRET=you_jwt_secret_key
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=72h



# LocalStack exposes every AWS service on port 4566.
# Leave AWS_S3_ENDPOINT empty to talk to real AWS S3 instead.
AWS_REGION=us-east-1
AWS_ACCESS_KEY=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=ecommerce-uploads
AWS_S3_ENDPOINT=http://localhost:4566
# Address browsers load images from - the nginx CDN in front of S3.
# Leave empty to serve straight off AWS_S3_ENDPOINT.
AWS_S3_PUBLIC_ENDPOINT=http://localhost:8081

UPLOAD_PATH=./uploads
MAX_UPLOAD_SIZE=10485760
# local | s3
UPLOAD_PROVIDER=local
